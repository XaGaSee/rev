# --- Telegram ---
BOT_TOKEN=123456789:YOUR_TELEGRAM_BOT_TOKEN

# --- OpenRouter ---
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=OpenRouter Telegram Bot
OPENROUTER_APP_URL=https://t.me/your_bot

# --- Transcriptions (voice) ---
# Any OpenAI-compatible endpoint: OpenAI (whisper-1) or Groq (whisper-large-v3)
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# --- Access ---
# Comma separated Telegram user ids of administrators
ADMIN_IDS_RAW=
DAILY_MESSAGE_LIMIT=10
THROTTLING_RATE=0.7

# --- Model defaults ---
DEFAULT_MODEL=nvidia/nemotron-3.5-super-vl:free
DEFAULT_TEMPERATURE=0.7
# Sliding window: how many recent turns to load and the token budget
MAX_HISTORY_MESSAGES=12
MAX_CONTEXT_TOKENS=6000
MAX_OUTPUT_TOKENS=2048

# --- Storage / logging ---
DATABASE_PATH=bot.db
LOG_LEVEL=INFO
